<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/themes/landing/assets/css/style.css">
</head>
<body>
    <nav>
        <a href="/">Home</a> | <a href="/about">About</a>
        @* EJS authentication-dependent navigation is temporarily disabled.
        <% if (user && ['Editor', 'Manager', 'Administrator'].includes(user.role)) { %>
            <a href="/admin">Admin</a> | <a href="/admin/logout">Logout</a>
        <% } else if (user && user.role === 'Registered') { %>
            <a href="/admin/logout">Logout</a>
        <% } else { %>
            <a href="/admin/login">Login</a>
        <% } %>
        *@
    </nav>
    Landing Theme
    <hr>
    <main>
        @RenderBody()
    </main>
</body>
</html>
