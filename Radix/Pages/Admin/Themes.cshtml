@page "/admin/themes"
@model dotnet_server.Pages.Admin.ThemesModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Themes | Radix CMS";
    var username = User.Identity?.Name ?? "Editor";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Editor";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-page">
    <aside class="admin-sidebar">
        <div class="brand">Radix<span>CMS</span></div>
        <nav aria-label="Admin navigation">
            <ul class="admin-nav">
                <li><a href="/admin"><span class="icon" aria-hidden="true">▦</span>Dashboard</a></li>
                <li><span><span class="icon" aria-hidden="true">↻</span>Updates</span></li>
                <li><a href="/admin/pages"><span class="icon" aria-hidden="true">▤</span>Pages</a></li>
                <li class="active"><a href="/admin/themes"><span class="icon" aria-hidden="true">◈</span>Themes</a></li>
                <li><a href="/admin/media"><span class="icon" aria-hidden="true">▧</span>Media Library</a></li>
                <li><a href="/admin/users"><span class="icon" aria-hidden="true">♙</span>Users &amp; Roles</a></li>
                <li><a href="/admin/settings"><span class="icon" aria-hidden="true">⚙</span>Settings</a></li>
            </ul>
        </nav>
    </aside>
    <div class="admin-wrapper">
        <header class="admin-header">
            <a class="view-site" href="/">View Site</a>
            <div class="header-right">
                <span>Logged in as <strong>@username</strong></span>
                <span class="user-badge">@role</span>
                <form method="post" action="/admin/logout"><button class="logout-link" type="submit">Logout</button></form>
            </div>
        </header>
        <main class="admin-content">
            <section class="card">
                <h1>Installed Themes</h1>
                <p>Themes are loaded from <code>Radix/Themes</code>. Add a theme folder containing <code>_Layout.cshtml</code> and optional assets.</p>
                @if (Model.Themes.Count > 0)
                {
                    <div class="dashboard-cards">
                        @foreach (var theme in Model.Themes)
                        {
                            <article class="card">
                                <h2>@theme</h2>
                                <p><span class="page-status status-published">Installed</span></p>
                                <small><code>Themes/@theme/_Layout.cshtml</code></small>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-message">No themes were found. Add a theme folder with a _Layout.cshtml layout.</p>
                }
            </section>

            <section class="card">
                <h2>Apply a theme to a dynamic page</h2>
                <p>Choose an installed theme for each database-backed page.</p>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message" role="alert">@Model.ErrorMessage</div>
                }
                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="success-message" role="status">@statusMessage</div>
                }
                @if (Model.Pages.Count > 0)
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr><th>Page</th><th>Current Theme</th><th>Apply Theme</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var dynamicPage in Model.Pages)
                                {
                                    <tr>
                                        <td><strong>@dynamicPage.Title</strong><br /><small class="page-slug">/@dynamicPage.Slug</small></td>
                                        <td><code>@dynamicPage.TemplateName</code></td>
                                        <td>
                                            <form method="post" asp-page-handler="Assign" class="user-actions">
                                                <input type="hidden" name="pageId" value="@dynamicPage.Id" />
                                                <select name="themeName" aria-label="Theme for @dynamicPage.Title" required>
                                                    @foreach (var theme in Model.Themes)
                                                    {
                                                        <option value="@theme" selected="@(string.Equals(theme, dynamicPage.TemplateName, StringComparison.OrdinalIgnoreCase))">@theme</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-primary">Apply</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="empty-message">No dynamic pages are available.</p>
                }
            </section>
        </main>
    </div>
</body>
</html>
