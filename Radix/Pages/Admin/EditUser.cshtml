@page "/admin/users/edit/{id:int}"
@model dotnet_server.Pages.Admin.EditUserModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Edit User | Radix CMS";
    var username = User.Identity?.Name ?? "Admin";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Administrator";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-page">
    <aside class="admin-sidebar">
        <div class="brand">Radix<span>CMS</span></div>
        <nav aria-label="Admin navigation">
            <ul class="admin-nav">
                <li><a href="/admin"><span class="icon" aria-hidden="true">▦</span>Dashboard</a></li>
                <li><span><span class="icon" aria-hidden="true">↻</span>Updates</span></li>
                <li><a href="/admin/pages"><span class="icon" aria-hidden="true">▤</span>Pages</a></li>
                <li><a href="/admin/themes"><span class="icon" aria-hidden="true">◈</span>Themes</a></li>
                <li><a href="/admin/media"><span class="icon" aria-hidden="true">▧</span>Media Library</a></li>
                <li class="active"><a href="/admin/users"><span class="icon" aria-hidden="true">♙</span>Users &amp; Roles</a></li>
                <li><a href="/admin/settings"><span class="icon" aria-hidden="true">⚙</span>Settings</a></li>
            </ul>
        </nav>
    </aside>

    <div class="admin-wrapper">
        <header class="admin-header">
            <a class="view-site" href="/">View Site</a>
            <div class="header-right">
                <span>Logged in as <strong>@username</strong></span>
                <span class="user-badge">@role</span>
                <form method="post" action="/admin/logout"><button class="logout-link" type="submit">Logout</button></form>
            </div>
        </header>

        <main class="admin-content">
            <section class="card edit-user-card">
                <h1>Edit User</h1>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message" role="alert">@Model.ErrorMessage</div>
                }

                <form method="post" asp-route-id="@Model.UserId" class="edit-user-form">
                    <input type="hidden" asp-for="UserId" />
                    <div class="user-form-field">
                        <label asp-for="FullName">Full Name</label>
                        <input asp-for="FullName" maxlength="255" />
                    </div>
                    <div class="user-form-field">
                        <label asp-for="Username">Username</label>
                        <input asp-for="Username" required maxlength="100" autocomplete="off" />
                    </div>
                    <div class="user-form-field">
                        <label asp-for="Email">Email (Optional)</label>
                        <input asp-for="Email" type="email" maxlength="255" />
                    </div>
                    <div class="user-form-field">
                        <label asp-for="Role">Role</label>
                        <select asp-for="Role" required>
                            @foreach (var availableRole in UserRoles.All)
                            {
                                <option value="@availableRole">@availableRole</option>
                            }
                        </select>
                    </div>
                    <div class="user-form-field">
                        <label asp-for="Password">New Password (Optional)</label>
                        <input asp-for="Password" type="password" autocomplete="new-password" placeholder="Leave blank to keep current password" />
                    </div>
                    <div class="edit-user-actions">
                        <button type="submit" class="btn btn-primary">Update User</button>
                        <a href="/admin/users" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </section>
        </main>
    </div>
</body>
</html>
