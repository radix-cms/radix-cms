@page "/admin/access-denied"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Access Denied | Radix CMS";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="login-page">
    <main class="login-card">
        <h1>Access Denied</h1>
        <p class="login-description">Your account does not have permission to manage user roles.</p>
        <a class="btn btn-primary" href="/admin">Return to Dashboard</a>
    </main>
</body>
</html>
