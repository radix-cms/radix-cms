@page "/admin/create"
@model dotnet_server.Pages.Admin.CreatePageModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Create Page | Radix CMS";
    var username = User.Identity?.Name ?? "Editor";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Editor";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-page">
    <aside class="admin-sidebar">
        <div class="brand">Radix<span>CMS</span></div>
        <nav aria-label="Admin navigation">
            <ul class="admin-nav">
                <li><a href="/admin"><span class="icon" aria-hidden="true">▦</span>Dashboard</a></li>
                <li><span><span class="icon" aria-hidden="true">↻</span>Updates</span></li>
                <li class="active"><a href="/admin/pages"><span class="icon" aria-hidden="true">▤</span>Pages</a></li>
                <li><a href="/admin/themes"><span class="icon" aria-hidden="true">◈</span>Themes</a></li>
                <li><a href="/admin/media"><span class="icon" aria-hidden="true">▧</span>Media Library</a></li>
                <li><a href="/admin/users"><span class="icon" aria-hidden="true">♙</span>Users &amp; Roles</a></li>
                <li><a href="/admin/settings"><span class="icon" aria-hidden="true">⚙</span>Settings</a></li>
            </ul>
        </nav>
    </aside>
    <div class="admin-wrapper">
        <header class="admin-header">
            <a class="view-site" href="/">View Site</a>
            <div class="header-right">
                <span>Logged in as <strong>@username</strong></span>
                <span class="user-badge">@role</span>
                <form method="post" action="/admin/logout"><button class="logout-link" type="submit">Logout</button></form>
            </div>
        </header>
        <main class="admin-content">
            <section class="card edit-user-card page-editor-card">
                <h1>Create New Page</h1>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message" role="alert">@Model.ErrorMessage</div>
                }
                <form method="post" class="edit-user-form">
                    <div asp-validation-summary="ModelOnly" class="error-message"></div>
                    <div class="user-form-field">
                        <label asp-for="Title">Title</label>
                        <input asp-for="Title" required maxlength="255" />
                    </div>
                    <div class="user-form-field">
                        <label asp-for="Slug">URL Slug</label>
                        <div class="slug-input"><span>/</span><input asp-for="Slug" required maxlength="255" pattern="[a-z0-9]+(-[a-z0-9]+)*" /></div>
                        <small>Use lowercase letters, numbers, and hyphens.</small>
                    </div>
                    <div class="user-form-field">
                        <label asp-for="PageContent">Page Content (HTML)</label>
                        <textarea asp-for="PageContent" rows="12"></textarea>
                    </div>
                    <div class="page-options-grid">
                        <div class="user-form-field">
                            <label asp-for="Status">Status</label>
                            <select asp-for="Status">
                                @foreach (var status in PageEditorOptions.Statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="user-form-field">
                            <label asp-for="MinimumRole">Minimum Access</label>
                            <select asp-for="MinimumRole">
                                @foreach (var accessRole in UserRoles.All.Reverse())
                                {
                                    <option value="@accessRole">@accessRole</option>
                                }
                            </select>
                        </div>
                        <div class="user-form-field">
                            <label asp-for="TemplateName">Theme</label>
                            <select asp-for="TemplateName">
                                @foreach (var theme in Model.AvailableThemes)
                                {
                                    <option value="@theme">@theme</option>
                                }
                            </select>
                        </div>
                        <div class="user-form-field">
                            <label asp-for="PublishAt">Publish Date</label>
                            <input asp-for="PublishAt" type="datetime-local" />
                        </div>
                    </div>
                    <div class="edit-user-actions">
                        <button type="submit" class="btn btn-primary">Create Page</button>
                        <a href="/admin/pages" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </section>
        </main>
    </div>
    @await Html.PartialAsync("_PageContentEditorScripts")
</body>
</html>
