@page "/Error/{statusCode:int}"
@model dotnet_server.Pages.ErrorModel
@{
    Layout = null;
    ViewData["Title"] = $"{Model.ErrorStatusCode} | Radix";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme: light; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
        body { align-items: center; background: #f4f6f9; color: #2d3748; display: flex; justify-content: center; margin: 0; min-height: 100vh; padding: 1.5rem; }
        main { background: #fff; border-radius: .5rem; box-shadow: 0 4px 16px rgb(0 0 0 / 6%); max-width: 34rem; padding: 2.5rem; text-align: center; width: 100%; }
        h1 { color: #dd6b20; font-size: 3.5rem; margin: 0; }
        h2 { color: #4a5568; margin: .5rem 0 1rem; }
        p { color: #718096; line-height: 1.6; }
        nav { border-top: 1px solid #e2e8f0; margin-top: 1.5rem; padding-top: 1.25rem; }
        a { color: #2b6cb0; font-weight: 600; margin: 0 .5rem; text-decoration: none; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <main>
        <h1>@Model.ErrorStatusCode</h1>
        <h2>@Model.Title</h2>
        <p>@Model.Message</p>
        <nav aria-label="Helpful links">
            <a href="/">Home</a>
            <a href="/admin">Dashboard</a>
        </nav>
    </main>
</body>
</html>
