@page "/westbank-project-passwords"
@model dotnet_server.CustomCode.WestbankProjectPasswordsModel
@{
    Layout = "~/Themes/imprime/_Layout.cshtml";
    ViewData["Title"] = "Westbank Project Passwords";
}

<h1>Westbank Project Passwords</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newAccountForm">
        New Account
    </button>
</div>

<div class="collapse mb-4" id="newAccountForm">
    <div class="card card-body">
        <h2 class="h5">New Account</h2>
        <form method="post" asp-page-handler="Create">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="new-account">Account #</label>
                    <input class="form-control" id="new-account" name="Account" type="number" min="0" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="new-password">Password</label>
                    <input class="form-control" id="new-password" name="Password" type="text" maxlength="255" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="new-project-name">Project Name</label>
                    <input class="form-control" id="new-project-name" name="ProjectName" type="text" maxlength="255" required>
                </div>
            </div>
            <button class="btn btn-success mt-3" type="submit">Create Account</button>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Account</th>
                <th>Password</th>
                <th>Project Account # and Name</th>
                <th class="text-end">Options</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ProjectList.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <tr><td colspan="4">No Westbank project accounts found.</td></tr>
            }
            @foreach (var project in Model.ProjectList)
            {
                <tr>
                    <td>@project.Account@@astleygilbert.com</td>
                    <td>@project.Password</td>
                    <td>Acct# @project.Account - @project.ProjectName</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse"
                                data-bs-target="#edit-account-@project.Id">Edit</button>
                        <form class="d-inline" method="post" asp-page-handler="Delete"
                              asp-route-id="@project.Id"
                              onsubmit="return confirm('Delete this account?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
                <tr class="collapse" id="edit-account-@project.Id">
                    <td colspan="4">
                        <form method="post" asp-page-handler="Edit" asp-route-id="@project.Id">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="account-@project.Id">Account #</label>
                                    <input class="form-control" id="account-@project.Id" name="Account"
                                           type="number" min="0" value="@project.Account" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="password-@project.Id">Password</label>
                                    <input class="form-control" id="password-@project.Id" name="Password"
                                           type="text" maxlength="255" value="@project.Password" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="project-name-@project.Id">Project Name</label>
                                    <input class="form-control" id="project-name-@project.Id" name="ProjectName"
                                           type="text" maxlength="255" value="@project.ProjectName" required>
                                </div>
                            </div>
                            <button class="btn btn-success mt-3" type="submit">Save Changes</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
